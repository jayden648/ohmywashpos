# Keep the Docker build context small and secret-free.
.git
.github
.gitignore
.env
.env.*
!.env.example
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
*.log
*.sqlite
_*.txt
_*.bat
_v_serve*.txt
audit_*.ps1
.idea
.vscode
.DS_Store
Thumbs.db
